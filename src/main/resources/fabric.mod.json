{
  "schemaVersion": 1,
  "id": "richchat",
  "version": "${version}",
  "name": "RichChat",
  "description": "在 Minecraft 聊天栏中渲染 Markdown 与 LaTeX 公式 (Unicode 近似), 并通过悬停查看原始源码.",
  "authors": [
    "RichChat"
  ],
  "contact": {
    "homepage": "https://github.com/example/richchat",
    "sources": "https://github.com/example/richchat"
  },
  "license": "MIT",
  "icon": "assets/richchat/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.example.richchat.RichChatMod"
    ],
    "client": [
      "com.example.richchat.client.RichChatClient"
    ]
  },
  "mixins": [
    "richchat.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
